{
  "name": "fra-li-monti",
  "version": "1.0.0",
  "description": "Planificateur hors ligne du GR20 : étapes, carte, hébergements, météo et plan de trek nuit par nuit (PWA Nuxt 4).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relisora/gr20.git"
  },
  "homepage": "https://github.com/relisora/gr20",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "prebuild": "npm run data:publish",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "data:trace": "node scripts/fetch-trace.mjs",
    "data:elevation": "node scripts/add-elevation.mjs",
    "data:segments": "node scripts/build-segments.mjs",
    "data:publish": "mkdir -p public/data && cp data/raw/trace-main-elev.geojson data/raw/trace-var-incudine-elev.geojson public/data/",
    "data:dispo": "node scripts/scan-dispo.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/ui": "^4.10.0",
    "leaflet": "^1.9.4",
    "nuxt": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/leaflet": "^1.9.21",
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
